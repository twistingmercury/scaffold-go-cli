#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJ_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

APP_NAME="${APP_NAME:-{{APP_NAME}}}"
# Read from go.mod with awk because the CI runner has no Go toolchain installed.
MODULE_NAME="${MODULE_NAME:-$(awk '/^module /{print $2}' "${PROJ_ROOT}/src/go.mod")}"

# Docker image and compose project names must be lowercase, even when APP_NAME isn't.
DOCKER_NAME="$(printf '%s' "${APP_NAME}" | tr '[:upper:]' '[:lower:]')"

IMAGE_NAME="${IMAGE_NAME:-${DOCKER_NAME}_docker_image}"
IMAGE_TAG="${IMAGE_TAG:-latest}"
OUTPUT_DIR="${OUTPUT_DIR:-${PROJ_ROOT}/.bin}"

COMPOSE_FILE="${PROJ_ROOT}/tests/docker-compose.yaml"
# The PID suffix keeps parallel runs on one machine from sharing compose resources.
COMPOSE_PROJECT="${COMPOSE_PROJECT:-${DOCKER_NAME}-black-box-$$}"

BUILD_VER="${BUILD_VER:-$(git -C "${PROJ_ROOT}" describe --tags --abbrev=0 2>/dev/null || echo 'dev')}"
BUILD_DATE="${BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
BUILD_COMMIT="${BUILD_COMMIT:-$(git -C "${PROJ_ROOT}" rev-parse --short HEAD 2>/dev/null || echo 'unknown')}"

build() {
    printf "building %s..." "${APP_NAME}"
    docker build --rm --no-cache --pull --progress=plain \
        --file "${SCRIPT_DIR}/Dockerfile" \
        --build-arg BUILD_VER="${BUILD_VER}" \
        --build-arg BUILD_DATE="${BUILD_DATE}" \
        --build-arg BUILD_COMMIT="${BUILD_COMMIT}" \
        --build-arg APP_NAME="${APP_NAME}" \
        --build-arg MODULE_NAME="${MODULE_NAME}" \
        --target export \
        --output "type=local,dest=${OUTPUT_DIR}" \
        --tag "${IMAGE_NAME}:${IMAGE_TAG}" \
        "${PROJ_ROOT}"

    printf "done\n"
}

black_box_tests() {
    local rc=0
    printf "starting black-box tests..."
    docker compose --progress=plain -p "${COMPOSE_PROJECT}" -f "${COMPOSE_FILE}" build --no-cache --pull
    docker compose -p "${COMPOSE_PROJECT}" -f "${COMPOSE_FILE}" up --remove-orphans --exit-code-from tests || rc=$?
    docker compose -p "${COMPOSE_PROJECT}" -f "${COMPOSE_FILE}" down -v --remove-orphans --rmi local >/dev/null 2>&1 || true

    if [ "${rc}" -ne 0 ]; then
        printf "failed\n"
        return "${rc}"
    fi

    printf "done\n"
    return 0
}

main() {
    build
    black_box_tests
}

main "$@"