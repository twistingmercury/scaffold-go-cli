# Black-box tests run against the compiled binary only, never the Go source.
# They're written in bats on purpose: using a different language from the app
# keeps tests from reaching into its internals. Any language works, as long as
# the tests only run the binary at TARGET_BINARY and check its exit code,
# output, and side effects. The container's exit code is the test result.
FROM bats/bats:1.14.0@sha256:5322b877351fda0cc435de8c6116de7d0a2ec79d7c680132a0ef329a633bc66f AS final

# Copy the pre-built binary exported by build/Dockerfile into the container.
# build/build.sh must run before docker compose up so the binary exists in .bin/.
ARG GOARCH=amd64
ARG GOOS=linux
COPY .bin/${GOARCH}/${GOOS}/{{APP_NAME}} /usr/local/bin/{{APP_NAME}}

WORKDIR /workspace/tests/black_box
COPY tests/black_box/ .

ENV TARGET_BINARY=/usr/local/bin/{{APP_NAME}}

USER 65532:65532

# The image's entrypoint is bats, so this is the path to the tests.
CMD ["."]
