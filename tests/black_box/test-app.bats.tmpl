#!/usr/bin/env bats

load 'test_helper/bats-support/load'
load 'test_helper/bats-assert/load'

# The test image sets TARGET_BINARY; the default runs against `make local` output.
TARGET_BINARY="${TARGET_BINARY:-${BATS_TEST_DIRNAME}/../../.bin/local/{{APP_NAME}}}"

@test "{{APP_NAME}} run with no config - prints the empty project message" {
    run "${TARGET_BINARY}"

    assert_success
    assert_output "This is an empty Go project. Replace this with your app."
}

@test "{{APP_NAME}} with --version - prints the build's version details" {
    run "${TARGET_BINARY}" --version

    assert_success
    assert_line --regexp '^{{APP_NAME}} version: .+$'
    assert_line --regexp '^commit: .+$'
}

@test "{{APP_NAME}} with -h - prints usage listing the flags" {
    run "${TARGET_BINARY}" -h

    assert_success
    assert_line "Usage: {{APP_NAME}} [flags]"
    assert_output --partial "--version"
}
